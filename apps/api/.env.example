DATABASE_URL=postgres://erp:erp@localhost:5432/erp
JWT_SECRET=change-me-in-production
PORT=4000
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
# Public invoice links (docs/WHATSAPP_SHARING.md). PUBLIC_APP_URL is the origin customers open —
# https in production (http is accepted only for localhost). PUBLIC_LINK_SECRET: 32+ random chars,
# e.g. node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
# Server-side only; never commit a real value. Changing it invalidates every invoice link already sent.
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_LINK_SECRET=
