<?xml version="1.0" encoding="UTF-8"?>
<!--
  The IIS front for StudioCRM on site4now, and the file that decides whether the site answers at
  all. It belongs in the SITE ROOT (h:\root\home\jigneshsatani-001\www\studio).

  How this host really works: railpack builds the app inside a Linux container, then the built
  tree is tarred, copied to the WINDOWS site folder and extracted there. IIS is the front door and
  starts Node through httpPlatformHandler. So the build is Linux and the runtime is Windows+IIS.

  The host's deploy step rewrites web.config afterwards and its version omits the <httpPlatform>
  element entirely - the handler is registered but nothing tells IIS which process to start, which
  is a 502 on every request. This file is the fix, and it has to be re-applied after each deploy
  until the host stops doing that. `deploy/Deploy-StudioCRM.ps1 -FixWebConfig` uploads it.

  Two things here are deliberate and must not be "tidied":

  1. NO <rewrite> rules. The host's template rewrites anything that is not a file to /index.html,
     which would turn /api/health into the SPA shell and break the entire API. Routing belongs to
     the app: server.js serves /api, serves the fingerprinted assets, and falls back to index.html
     itself (apps/api/src/plugins/web.ts).
  2. PORT comes from %HTTP_PLATFORM_PORT%. IIS picks the port and expects the child process to
     listen on exactly that one; server.ts reads PORT and binds 0.0.0.0. Hard-coding a port here
     is a guaranteed 502.

  No secret appears in this file. DATABASE_URL and JWT_SECRET are read from the .env file in the
  site root, which is uploaded by hand and is not in git.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpplatformhandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>

    <httpPlatform processPath="C:\Program Files\nodejs\node.exe"
                  arguments="apps\api\dist\server.js"
                  startupTimeLimit="120"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\node.log">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
      </environmentVariables>
    </httpPlatform>

    <security>
      <requestFiltering>
        <!-- Just above the API's own 20 MB multipart limit, so the app refuses an oversized
             upload with its own JSON error rather than IIS refusing it with HTML. -->
        <requestLimits maxAllowedContentLength="22020096" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
