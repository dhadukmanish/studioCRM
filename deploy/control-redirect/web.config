<?xml version="1.0" encoding="UTF-8"?>
<!--
  control.kriviinfotech.com — the platform panel's address. The host cannot bind a second domain to
  the studio site (a subdomain site), so this separate site only redirects every request to the
  panel on the studio site. Upload this file (and index.html, a fallback) to the ROOT of the
  control site's folder. Nothing else belongs there. See docs/SUBSCRIPTIONS.md.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="To the platform panel" stopProcessing="true">
          <match url=".*" />
          <action type="Redirect" url="https://studio.kriviinfotech.com/platform" redirectType="Found" appendQueryString="false" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
